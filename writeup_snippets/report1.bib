  isbn = {978-1-5386-6027-0},
  langid = {english},
  file = {/home/timmy/Zotero/storage/AXNEAPEZ/Garforth and Webb - 2019 - Visual Appearance Analysis of Forest Scenes for Mo.pdf}
}


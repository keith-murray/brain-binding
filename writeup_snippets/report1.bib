@article{rafieiRTNetNeuralNetwork,
  title = {{{RTNet}}: {{A}} Neural Network That Exhibits the Signatures of Human Perceptual Decision Making},
  author = {Rafiei, Farshad and Shekhar, Medha and Rahnev, Dobromir},
  abstract = {Convolutional neural networks currently provide the best models of biological vision. However, their decision behavior, including the facts that they are deterministic and use equal number of computations for easy and difficult stimuli, differs markedly from human decision-making, thus limiting their applicability as models of human perceptual behavior. Here we develop a new neural network, RTNet, that generates stochastic decisions and human-like response time (RT) distributions, and also reproduces all foundational features of human accuracy, RT, and confidence. To test RTNet's ability to predict human behavior on novel images, we collected accuracy, RT, and confidence data from 60 human subjects performing a digit discrimination task. We found that the accuracy, RT, and confidence produced by RTNet for individual novel images correlated with the same quantities produced by human subjects. Critically, human subjects who were more similar to the average human performance were also found to be closer to RTNet's predictions. Overall, RTNet is a promising model of human response times that exhibits the critical signatures of perceptual decision making.},
  langid = {english},
  file = {/home/timmy/Zotero/storage/25D3FBK9/Rafiei et al. - RTNet A neural network that exhibits the signatur.pdf}
}

@article{rajalinghamRecurrentNeuralNetworks2022,
  title = {Recurrent Neural Networks with Explicit Representation of Dynamic Latent Variables Can Mimic Behavioral Patterns in a Physical Inference Task},
  author = {Rajalingham, Rishi and Piccato, A{\'i}da and Jazayeri, Mehrdad},
  year = 2022,
  month = oct,
  journal = {Nature Communications},
  volume = {13},
  number = {1},
  pages = {5865},
  issn = {2041-1723},
  doi = {10.1038/s41467-022-33581-6},
  urldate = {2024-02-09},
  abstract = {Abstract             Primates can richly parse sensory inputs to infer latent information. This ability is hypothesized to rely on establishing mental models of the external world and running mental simulations of those models. However, evidence supporting this hypothesis is limited to behavioral models that do not emulate neural computations. Here, we test this hypothesis by directly comparing the behavior of primates (humans and monkeys) in a ball interception task to that of a large set of recurrent neural network (RNN) models with or without the capacity to dynamically track the underlying latent variables. Humans and monkeys exhibit similar behavioral patterns. This primate behavioral pattern is best captured by RNNs endowed with dynamic inference, consistent with the hypothesis that the primate brain uses dynamic inferences to support flexible physical predictions. Moreover, our work highlights a general strategy for using model neural systems to test computational hypotheses of higher brain function.},
  langid = {english},
  file = {/home/timmy/Zotero/storage/TG4UXZGV/Rajalingham et al. - 2022 - Recurrent neural networks with explicit representa.pdf}
}


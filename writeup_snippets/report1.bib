}

@misc{Miller2023,
  title = {Cognitive {{Model Discovery}} via {{Disentangled RNNs}}},
  author = {Miller, Kevin J. and Eckstein, Maria and Botvinick, Matthew M. and {Kurth-Nelson}, Zeb},
  year = 2023,
  month = jun,
  doi = {10.1101/2023.06.23.546250},
  urldate = {2024-06-11},
  abstract = {Computational cognitive models are a fundamental tool in behavioral neuroscience. They instantiate in software precise hypotheses about the cognitive mechanisms underlying a particular behavior. Constructing these models is typically a difficult iterative process that requires both inspiration from the literature and the creativity of an individual researcher. Here, we adopt an alternative approach to learn parsimonious cognitive models directly from data. We fit behavior data using a recurrent neural network that is penalized for carrying information forward in time, leading to sparse, interpretable representations and dynamics. When fitting synthetic behavioral data from known cognitive models, our method recovers the underlying form of those models. When fit to laboratory data from rats performing either a reward learning task or a decision-making task, our method recovers simple and interpretable models that make testable predictions about neural mechanisms.},

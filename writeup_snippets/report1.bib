@article{whittingtonttaSsepsmauhcm2025,
  title = {A Tale of Two Algorithms: {{Structured}} Slots Explain Prefrontal Sequence Memory and Are Unified with Hippocampal Cognitive Maps},
  shorttitle = {A Tale of Two Algorithms},
  author = {Whittington, James C.R. and Dorrell, William and Behrens, Timothy E.J. and Ganguli, Surya and {El-Gaby}, Mohamady},

}

@article{rodriguezMCLDESTAMPI2024,
  title = {Motor {{Cortex Latent Dynamics Encode Spatial}} and {{Temporal Arm Movement Parameters Independently}}},
  author = {Rodriguez, Andrea Colins and Perich, Matt G. and Miller, Lee E. and Humphries, Mark D.},

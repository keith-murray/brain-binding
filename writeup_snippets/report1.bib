  author = {Zhang, Xiang and Cao, Qichen and Gao, Kai and Chen, Cong and Cheng, Sihui and Li, Ang and Zhou, Yuqian and Liu, Ruojin and Hao, Jun and Kropff, Emilio and Miao, Chenglin},
  year = 2024,
